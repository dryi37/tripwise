# Runtime and HTTP server
NODE_ENV=development
PORT=3101
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
API_JSON_BODY_LIMIT_BYTES=1048576

# Database and currency conversion
DATABASE_URL=postgresql://tripwise:tripwise@localhost:55432/tripwise?schema=public
FX_RATE_API_URL=https://api.frankfurter.dev/v2
FX_RATE_TIMEOUT_MS=10000
FX_RATE_CACHE_TTL_MS=21600000

# Agent settings: provider, budgets, and rate limits
AGENT_MODEL_PROVIDER=gemini
AGENT_REQUEST_TIMEOUT_MS=600000
AGENT_MODEL_CALLS_PER_DAY=20
AGENT_TOOL_CALLS_PER_DAY=40
AGENT_SEARCH_RESULTS_PER_TOOL=3
AGENT_RATE_LIMIT_MAX_REQUESTS=10
AGENT_RATE_LIMIT_WINDOW_MS=60000

# Agent provider: Gemini/Gemma (GEMINI_API_KEY also powers existing embeddings)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_REQUEST_TIMEOUT_MS=60000
GEMMA_MAX_RETRIES=7
GEMMA_MAX_TOOL_RESULT_CONTEXT_CHARS=14000
# Summarize near the input token limit.
GEMMA_SUMMARY_TRIGGER_TOKENS=12000
GEMMA_MAX_INPUT_TOKENS=16000
GEMMA_RETRY_BASE_DELAY_MS=250
GEMMA_RETRY_MAX_DELAY_MS=5000
GEMMA_MAX_OUTPUT_TOKENS=4096

# Agent provider: GX10 OpenAI-compatible chat only
GX10_BASE_URL=http://172.16.110.26:7997/v1
GX10_API_KEY=
GX10_MODEL=qwen3.6-35b-a3b
GX10_REQUEST_TIMEOUT_MS=120000
GX10_MAX_RETRIES=2
GX10_MAX_TOOL_RESULT_CONTEXT_CHARS=14000
GX10_RETRY_BASE_DELAY_MS=500
GX10_RETRY_MAX_DELAY_MS=5000
GX10_MAX_OUTPUT_TOKENS=4096

# Knowledge embeddings and vector storage
EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=tripwise_knowledge
QDRANT_CATALOG_COLLECTION=tripwise_catalog_offers
QDRANT_REQUEST_TIMEOUT_MS=10000
QDRANT_COLLECTION_CHECK_TIMEOUT_MS=5000
QDRANT_PAYLOAD_BATCH_SIZE=256

# Place lookup and rate limits
PHOTON_API_URL=https://photon.komoot.io
PHOTON_TIMEOUT_MS=8000
PHOTON_CACHE_TTL_MS=21600000
PLACE_SEARCH_SELECTION_TTL_MS=900000
PLACE_SEARCH_MAX_SELECTIONS=1000
PLACE_SEARCH_RATE_LIMIT_MAX_REQUESTS=30
PLACE_SEARCH_RATE_LIMIT_WINDOW_MS=60000

# Public web research
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SOURCE_STALE_DAYS=180

# Application logs
APP_LOG_FILE=../artifacts/logs/backend/application.jsonl

